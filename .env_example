VLLM_API_KEY=<your_super_secret_vllm_api_key_goes_here>

## optional
# HF_TOKEN=<your_huggingface_token>          # download of gated models on the GPU machine, e.g. google/gemma-4-31B-it (judge):
#                                            # create a token at https://huggingface.co/settings/tokens and accept the license on the model page
# HF_HOME=<path>                             # cache of the LLM weights on the GPU machine, default ~/.cache/huggingface
## any entry of configs/config.yaml can be overwritten here, e.g.:
# PATH_DATA=/scratch/<user>/data
# LLM_EXTRACTOR_BASE_URL=http://<gpu-node>:8000/v1
