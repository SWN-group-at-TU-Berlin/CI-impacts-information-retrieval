VLLM_API_KEY=<your_super_secret_vllm_api_key_goes_here>

## optional
# HF_TOKEN=<your_huggingface_token>          # download of gated models on the GPU machine
# HF_HOME=<path>                             # cache of the LLM weights on the GPU machine, default ~/.cache/huggingface
## any entry of configs/config.yaml can be overwritten here, e.g.:
# PATH_DATA=/scratch/<user>/data
# LLM1_BASE_URL=http://<gpu-node>:8000/v1
